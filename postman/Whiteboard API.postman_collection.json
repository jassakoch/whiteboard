      "name": "Auth",
      "item": [
        {
          "name": "Register new user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "//1. Generate unique data/input",
                  "const uniqueId = Date.now();",
                  "const email = `milo_${uniqueId}@gmail.com`",
                  "",
                  "//2. STORE. Use it for the \"Identifiers\"(email)",
                  "pm.environment.set(\"registeredEmail\", email);",
                  "pm.environment.set(\"userFirstName\", \"Milo\");",
                  "pm.environment.set(\"userLastName\", \"TestLastName\");",
                  "pm.environment.set(\"testPassword\", \"PassWord123!\")",
                  "",
                  "//3. Verify",
                  "console.log(\"Preparing to register user: \" + email)",
                  " ",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 3. Parse Response",
                  "const jsonData = pm.response.json();",
                  "",
                  "// 4. Capture the ID for future requests ",
                  "if (jsonData.user && jsonData.user._id) {",
                  "    pm.environment.set(\"userId\", jsonData.user._id);",
                  "}",
                  "",
                  "// 5. Tests",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201); ",
                  "});",
                  "",
                  "pm.test(\"Verify success message\", function () {",
                  "    pm.expect(jsonData.message).to.eql(\"User registered successfully\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disabledSystemHeaders": {}
          },
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"{{userFirstName}}\",\n    \"lastName\": \"{{userLastName}}\",\n    \"email\": \"{{registeredEmail}}\",\n    \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "",
                  "// Save auth token if present",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"authToken\", jsonData.token);",
                  "    console.log(\"Login successful! Token saved.\");",
                  "    ",
                  "    // Decode middle part of JWT token to get ID of the user",
                  "    try {",
                  "        const payload = JSON.parse(atob(jsonData.token.split('.')[1]));",
                  "        if (payload.id) {",
                  "            pm.environment.set(\"userId\", payload.id);",
                  "            console.log(\"User ID extracted: \" + payload.id);",
                  "        } else {",
                  "            console.log(\"No user ID found in token payload\");",
                  "        }",
                  "    } catch (e) {",
                  "        console.log(\"Error decoding token: \" + e);",
                  "    }",
                  "} else {",
                  "    console.log(\"No token found in response\");",
                  "}",
                  "",
                  "// Tests",
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Server returned a success message\", function () {",
                  "    pm.expect(jsonData.message).to.eql(\"Login successful\");",
                  "});",
                  "",
                  "pm.test(\"Response contains a token\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"token\");",
                  "    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            }
          },
          "response": []
        },
