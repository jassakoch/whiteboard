          "name": "Create whiteboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse the response",
                  "const jsonData = pm.response.json();",
                  "",
                  "// Save the ID of the new whiteboard to an environment variable",
                  "if (jsonData._id) {",
                  "    // Force it to stay a string so digits don't get lost",
                  "    const fullId = String(jsonData._id); ",
                  "    pm.environment.set(\"WhiteboardId\", fullId);",
                  "    ",
                  "    console.log(\"Saved ID: \" + fullId);",
                  "    console.log(\"ID Character Count: \" + fullId.length); // Should be 24",
                  "}",
                  "// This checks if the server actually saved it (Status 201 Created)",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// This ensures the response actually contains an ID",
                  "pm.test(\"Response has a Whiteboard ID\", function () {",
                  "    pm.expect(jsonData._id).to.exist;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "//Input/generate: Create unique string:",
                  "const timestamp = new Date().getTime();",
                  "const autoTitle = \"Title_of_Board\" + timestamp;",
                  "",
                  "//2. Store it.",
                  "pm.variables.set(\"autoGeneratedTitle\", autoTitle);",
                  "",
                  "//3.Log it",
                  "console.log(\"Auto-generated Title: \" + autoTitle);",
                  "",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
