                  "});",
                  "",
                  "//Check if hte correct user is returned?",
                  "pm.test(\"User ID belongs to logged-in user\", function() {",
                  "    pm.expect(jsonData._id).to.equal(savedId)",
                  "    });",
                  "",
                  "    pm.environment.set(\"currentId\", jsonData._id);"
